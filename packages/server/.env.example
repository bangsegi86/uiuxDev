# Storage driver: local | postgres | oracle
STORAGE_DRIVER=local

# Server
PORT=4000
HOST=0.0.0.0
# Set to "production" to enforce security: AUTH_SECRET + ALLOWED_ORIGINS required,
# admin password not logged, HSTS header enabled.
NODE_ENV=development

# Auth — token signing secret. REQUIRED (>=16 chars) when NODE_ENV=production.
AUTH_SECRET=dev-insecure-secret-change-me

# CORS allow-list (comma-separated). REQUIRED in production; any origin in dev.
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Seeded admin account (created on first boot if absent). Change for production.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin1234

# Local file storage (used when STORAGE_DRIVER=local)
DATA_DIR=./data
# Uploaded images (defaults to <DATA_DIR>/uploads)
# UPLOAD_DIR=./data/uploads

# PostgreSQL (used when STORAGE_DRIVER=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=uiux

# Oracle (used when STORAGE_DRIVER=oracle)
# Requires the `oracledb` driver and Oracle Instant Client at runtime.
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# or set host/port/service individually:
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
