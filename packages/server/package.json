{
  "name": "@uiux/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/smoke.ts",
    "migrate": "knex migrate:latest --knexfile ./src/db/knexfile.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@uiux/shared": "*",
    "fastify": "^5.1.0",
    "knex": "^3.1.0",
    "nanoid": "^5.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "oracledb": "^6.7.0",
    "pg": "^8.13.1"
  }
}
